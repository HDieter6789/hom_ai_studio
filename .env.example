# Copy this file to .env and adjust values before running docker compose.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=hom
POSTGRES_PASSWORD=hom
POSTGRES_DB=hom_ai_studio
POSTGRES_PORT=5432

# --- Backend API (apps/api) ---
HOM_ENVIRONMENT=development
HOM_DATABASE_URL=postgresql+psycopg://hom:hom@postgres:5432/hom_ai_studio
HOM_REDIS_URL=redis://redis:6379/0
# Generate real secrets for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HOM_SECRET_KEY=dev-only-insecure-secret-change-me
HOM_INTERNAL_API_TOKEN=dev-only-internal-token-change-me
HOM_STORAGE_ROOT=/data/storage
HOM_MAX_UPLOAD_SIZE_MB=512
HOM_CORS_ORIGINS=["http://localhost:3000"]
HOM_SEED_ON_START=true

# --- Training worker (services/training-worker) ---
HOM_WORKER_KEY=gpu-worker-01
HOM_COMPUTE_PROVIDER=local
# HOM_REMOTE_GPU_AGENT_URL=http://remote-gpu-box:9000
HOM_LLAMA_FACTORY_REPO=/srv/vendor/LLaMA-Factory

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
